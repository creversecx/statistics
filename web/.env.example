# --- Supabase (회사 계정 ulcdap@gmail.com 소유 프로젝트) ---
# 비워 두면 로컬 개발용 내장 Postgres(PGlite, web/.pglite 폴더)를 씁니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# 세션 쿠키 암호화 (32자 이상 임의 문자열)
SESSION_SECRET=replace-with-a-long-random-string

# Resend (가입 승인 요청·승인 안내·비밀번호 설정 메일). 비워 두면 메일 대신 서버 콘솔에 찍힙니다.
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=noreply@your-domain

# 메일 속 링크가 가리킬 주소 (Vercel 도메인)
APP_URL=https://your-domain.vercel.app

# 가입을 허용할 메일 도메인 (쉼표로 여러 개, * = 모두)
SIGNUP_ALLOWED_DOMAINS=creverse.com
